{
  "realm": "lms",
  "displayName": "LMS",
  "enabled": true,
  "organizationsEnabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "rememberMe": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(10) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": ["ko", "en"],
  "defaultLocale": "ko",
  "smtpServer": {
    "host": "${LMS_SMTP_HOST:mailpit}",
    "port": "${LMS_SMTP_PORT:1025}",
    "from": "${LMS_SMTP_FROM:no-reply@lms.local}",
    "fromDisplayName": "LMS"
  },
  "clients": [
    {
      "clientId": "lms-web",
      "name": "LMS Web (BFF)",
      "description": "Next.js server. Confidential client: only the server holds tokens.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LMS_WEB_CLIENT_SECRET:lms-web-dev-secret}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["${LMS_APP_URL:http://localhost:3000}/auth/callback", "${LMS_APP_URL:http://localhost:3000}/auth/login"],
      "webOrigins": ["${LMS_APP_URL:http://localhost:3000}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${LMS_APP_URL:http://localhost:3000}/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email"],
      "optionalClientScopes": ["organization", "offline_access"],
      "protocolMappers": [
        {
          "name": "audience-lms-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "lms-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lms-api",
      "name": "LMS API (resource server)",
      "description": "Audience only. The Spring API validates tokens issued for it; it never logs anyone in.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "${LMS_API_CLIENT_SECRET:lms-api-unused-secret}"
    },
    {
      "clientId": "lms-admin",
      "name": "LMS Admin API caller",
      "description": "Service account the Spring API uses to manage organizations (client credentials).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LMS_ADMIN_CLIENT_SECRET:lms-admin-dev-secret}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-lms-admin",
      "enabled": true,
      "serviceAccountClientId": "lms-admin",
      "clientRoles": {
        "realm-management": ["manage-realm", "manage-users", "view-users", "query-users"]
      }
    }
  ],
  "browserFlow": "browser-one-page",
  "authenticationFlows": [
    {
      "alias": "browser-one-page",
      "description": "Email and password on one page, instead of the built-in identity-first flow (email, then password). Members of several organizations pick one in the app (/onboarding): see docs/01 section 3.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "identity-provider-redirector", "authenticatorFlow": false, "requirement": "ALTERNATIVE", "priority": 20, "userSetupAllowed": false },
        { "flowAlias": "browser-one-page forms", "authenticatorFlow": true, "requirement": "ALTERNATIVE", "priority": 30, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "browser-one-page forms",
      "description": "Email and password, then OTP for users who set one up.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-username-password-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "flowAlias": "browser-one-page conditional otp", "authenticatorFlow": true, "requirement": "CONDITIONAL", "priority": 20, "userSetupAllowed": false }
      ]
    },
    {
      "alias": "browser-one-page conditional otp",
      "description": "OTP only when the user has configured it.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "conditional-user-configured", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 10, "userSetupAllowed": false },
        { "authenticator": "auth-otp-form", "authenticatorFlow": false, "requirement": "REQUIRED", "priority": 20, "userSetupAllowed": false }
      ]
    }
  ]
}
