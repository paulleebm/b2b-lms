{
  "realm": "lms",
  "displayName": "LMS",
  "enabled": true,
  "organizationsEnabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "rememberMe": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(10) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "internationalizationEnabled": true,
  "supportedLocales": ["ko", "en"],
  "defaultLocale": "ko",
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@lms.local",
    "fromDisplayName": "LMS"
  },
  "clients": [
    {
      "clientId": "lms-web",
      "name": "LMS Web (BFF)",
      "description": "Next.js server. Confidential client: only the server holds tokens.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lms-web-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": ["http://localhost:3000/auth/callback", "http://localhost:3000/auth/login"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "roles", "basic", "email"],
      "optionalClientScopes": ["organization", "offline_access"],
      "protocolMappers": [
        {
          "name": "audience-lms-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "lms-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lms-api",
      "name": "LMS API (resource server)",
      "description": "Audience only. The Spring API validates tokens issued for it; it never logs anyone in.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "lms-api-unused-secret"
    },
    {
      "clientId": "lms-admin",
      "name": "LMS Admin API caller",
      "description": "Service account the Spring API uses to manage organizations (client credentials).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lms-admin-dev-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-lms-admin",
      "enabled": true,
      "serviceAccountClientId": "lms-admin",
      "clientRoles": {
        "realm-management": ["manage-realm", "manage-users", "view-users", "query-users"]
      }
    }
  ]
}
