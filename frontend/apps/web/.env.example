# Copy to .env.local for local development. All values are validated with zod at startup
# (src/server/env-schema.ts). These are DEV-ONLY values matching infra/ docker compose.

# Public URL of this Next.js app (BFF). Redirect URI = ${APP_URL}/auth/callback
APP_URL=http://localhost:3000

# Keycloak realm issuer (OIDC discovery: ${KEYCLOAK_ISSUER}/.well-known/openid-configuration)
KEYCLOAK_ISSUER=http://localhost:8080/realms/lms
KEYCLOAK_CLIENT_ID=lms-web
KEYCLOAK_CLIENT_SECRET=lms-web-dev-secret

# Session store (login state, tokens)
REDIS_URL=redis://localhost:6379

# Spring API (resource server)
API_URL=http://localhost:8081

# Browser uploads go straight to object storage; its origin is allowed in the CSP at build time.
# Local: S3Mock. AWS: https://<bucket>.s3.ap-northeast-2.amazonaws.com
STORAGE_ORIGIN=http://localhost:9090
